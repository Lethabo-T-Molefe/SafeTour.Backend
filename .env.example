PROJECT_NAME=SafeTour AI Sentinel
DEBUG=true
VERSION=0.1.0

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/safetour

# Set true only for local bootstrap; prefer Alembic in shared/prod environments
AUTO_CREATE_TABLES=true

# Auth (FR-AUTH-2, NFR-SEC-2)
SECRET_KEY=your_super_secret_key_change_this_in_production!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

CORS_ORIGINS=["http://localhost:5173"]

# CFR-10 / FR-LOC-1
SUPPORTED_LANGUAGES=["en","af","zu","xh","st","tn"]
DEFAULT_LANGUAGE=en

PILOT_AREA_NAME=Tshwane

RISK_BAND_LOW_MAX=0.33
RISK_BAND_MEDIUM_MAX=0.66

REPORT_DECAY_HALF_LIFE_DAYS=14.0
REPORT_UNVERIFIED_MAX_WEIGHT=0.15

TRIP_SHARE_MAX_HOURS=12

# Optional integrations — every one of these is safe to leave unset; the app
# degrades deterministically per NFR-REL-2 (section 28).
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
WEATHER_API_URL=
POWER_STATUS_API_URL=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
